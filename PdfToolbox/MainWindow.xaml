<Window x:Class="PdfToolbox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PdfToolbox.ViewModels"
        xmlns:views="clr-namespace:PdfToolbox.Views"
        mc:Ignorable="d"
        Title="PDF全能工具箱"
        Height="720" Width="1150"
        MinHeight="550" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        WindowStyle="SingleBorderWindow">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- 页面切换动画 -->
        <Storyboard x:Key="PageTransitionIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.2"/>
            <ThicknessAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                From="20" To="0" Duration="0:0:0.2"
                                DecelerationRatio="0.2"/>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 侧边栏 -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo 区域 -->
                <StackPanel Grid.Row="0" Margin="20,20,20,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="28" Height="28" Margin="0,0,10,0">
                            <Path Data="{StaticResource IconWatermark}" Fill="{DynamicResource PrimaryBrush}" Stretch="Uniform"/>
                        </Viewbox>
                        <StackPanel>
                            <TextBlock Text="PDF 全能工具箱" FontSize="15" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="v1.3.0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- 分隔线 -->
                <Border Grid.Row="1" Height="1" Background="{DynamicResource SidebarBorderBrush}" Margin="16,8"/>

                <!-- Row 2 内容：主菜单 + 最近文件 + 底部菜单 -->
                <DockPanel Grid.Row="2" Margin="8,0,8,0">

                    <!-- 底部：设置/关于 (Bottom，先写=最底部) -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,8">
                        <Border Height="1" Background="{DynamicResource SidebarBorderBrush}" Margin="8,4"/>
                        <ListBox ItemsSource="{Binding BottomMenuItems}"
                                 SelectedItem="{Binding SelectedMenuItem, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="12,8"/>
                                    <Setter Property="Margin" Value="0,1"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder"
                                                        Background="{TemplateBinding Background}"
                                                        Padding="{TemplateBinding Padding}"
                                                        CornerRadius="8">
                                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SidebarSelectedBrush}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Viewbox Width="16" Height="16" Margin="0,0,10,0">
                                            <Path Data="{Binding Icon}" Fill="{Binding IconColor}" Stretch="Uniform"/>
                                        </Viewbox>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <!-- 最近文件 (Bottom，后写=在设置上方) -->
                    <!-- 主功能菜单 (最后写=fill剩余空间) -->
                    <ListBox ItemsSource="{Binding MainMenuItems}"
                             SelectedItem="{Binding SelectedMenuItem, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="0,8,0,0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Padding" Value="12,9"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}"
                                                    CornerRadius="8"
                                                    Margin="0,1">
                                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SidebarSelectedBrush}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Viewbox Width="18" Height="18" Margin="0,0,10,0">
                                        <Path Data="{Binding Icon}" Fill="{Binding IconColor}" Stretch="Uniform"/>
                                    </Viewbox>
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </DockPanel>

                <!-- 底部版本信息 -->
                <Border Grid.Row="3" Margin="16,8" Padding="12,8" Background="{DynamicResource SidebarFooterBrush}" CornerRadius="6">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <TextBlock Text="©小河田 2026" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="WeChat: DoAfterThink" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <Border Grid.Column="1" Background="{DynamicResource BackgroundBrush}" Margin="0">
            <Grid Margin="24,0,24,24">
                <ContentControl x:Name="PageContent" Content="{Binding CurrentViewModel}">
                    <ContentControl.RenderTransform>
                        <TranslateTransform/>
                    </ContentControl.RenderTransform>
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type vm:PdfReaderViewModel}">
                            <views:PdfReaderView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:PdfMergeViewModel}">
                            <views:PdfMergeView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:PdfSplitViewModel}">
                            <views:PdfSplitView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:PdfCropViewModel}">
                            <views:PdfCropView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:ImageToPdfViewModel}">
                            <views:ImageToPdfView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:DocumentToPdfViewModel}">
                            <views:DocumentToPdfView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:PdfWatermarkViewModel}">
                            <views:PdfWatermarkView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:PdfSecurityViewModel}">
                            <views:PdfSecurityView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:PdfToImageViewModel}">
                            <views:PdfToImageView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:OfdConvertViewModel}">
                            <views:OfdConvertView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                            <views:SettingsView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:AboutViewModel}">
                            <views:AboutView/>
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>
            </Grid>
        </Border>
    </Grid>
</Window>