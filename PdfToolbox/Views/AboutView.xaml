<UserControl x:Class="PdfToolbox.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:PdfToolbox.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AboutViewModel}"
             d:DesignHeight="600" d:DesignWidth="800">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="800"
                    HorizontalAlignment="Center"
                    Margin="0,24">

            <!-- 关于卡片 -->
            <Border Style="{StaticResource CardStyle}"
                    Padding="48,40">
                <StackPanel>

                    <!-- App 图标 -->
                    <Viewbox Width="72" Height="72"
                             Margin="0,0,0,20"
                             HorizontalAlignment="Center">
                        <Path Data="{StaticResource IconWatermark}"
                              Fill="{DynamicResource PrimaryBrush}"
                              Stretch="Uniform"/>
                    </Viewbox>

                    <!-- App 名称 -->
                    <TextBlock Text="{Binding AppName}"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6"/>

                    <!-- 版本号 -->
                    <TextBlock Text="{Binding Version, StringFormat=版本 {0}}"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,28"/>

                    <!-- 描述文字 -->
                    <TextBlock Text="{Binding Description}"
                               TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               LineHeight="22"
                               LineStackingStrategy="BlockLineHeight"
                               Margin="0,0,0,28"/>

                    <!-- 分隔线 -->
                    <Border Height="1"
                            Background="{DynamicResource BorderBrush}"
                            Margin="0,0,0,28"/>

                    <!-- 作者信息 -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,16">
                        <TextBlock Text="作者:"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Author}"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 联系作者按钮 -->
                    <Button Command="{Binding OpenWeChatCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,28"
                            Padding="40,14"
                            ToolTip="点击复制微信账号到剪贴板">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="联系作者: "
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding WeChat}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 版权信息 -->
                    <TextBlock Text="{Binding Copyright}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
