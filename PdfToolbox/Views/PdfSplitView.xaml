<UserControl x:Class="PdfToolbox.Views.PdfSplitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid x:Name="RootGrid"
          AllowDrop="True"
          DragEnter="RootGrid_DragEnter"
          DragOver="RootGrid_DragOver"
          DragLeave="RootGrid_DragLeave"
          Drop="RootGrid_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="PDF 拆分" Style="{StaticResource SectionTitleStyle}"/>

        <!-- 输入文件 -->
        <GroupBox Grid.Row="1" Header="📁 输入文件" Style="{StaticResource GroupBoxStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Text="PDF文件" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource TextBoxStyle}" Width="400" IsReadOnly="True"/>
                    <Button Content="浏览" Command="{Binding SelectInputFileCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0"/>
                </StackPanel>
                <TextBlock Grid.Row="1" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12">
                    <Run Text="总页数："/>
                    <Run Text="{Binding TotalPages, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>
            </Grid>
        </GroupBox>

        <!-- 拆分方式 -->
        <GroupBox Grid.Row="2" Header="⚙️ 拆分方式" Style="{StaticResource GroupBoxStyle}">
            <StackPanel>
                <RadioButton Content="按页范围拆分（如：1-5, 6-10）"
                             IsChecked="{Binding SelectedSplitMode, Converter={StaticResource RadioButtonConverter}, ConverterParameter=0}"/>
                <StackPanel Orientation="Horizontal" Margin="26,6,0,8">
                    <TextBlock Text="页码范围" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding PageRange, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource TextBoxStyle}" Width="200"/>
                </StackPanel>

                <RadioButton Content="拆分为单页（每页一个 PDF 文件）"
                             IsChecked="{Binding SelectedSplitMode, Converter={StaticResource RadioButtonConverter}, ConverterParameter=1}"/>

                <RadioButton Content="提取指定页码"
                             IsChecked="{Binding SelectedSplitMode, Converter={StaticResource RadioButtonConverter}, ConverterParameter=2}"/>
                <StackPanel Orientation="Horizontal" Margin="26,6,0,8">
                    <TextBlock Text="页码" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding ExtractedPages, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource TextBoxStyle}" Width="200"/>
                    <TextBlock Text="（逗号分隔）" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <RadioButton Content="提取奇数页（第 1、3、5... 页）"
                             IsChecked="{Binding SelectedSplitMode, Converter={StaticResource RadioButtonConverter}, ConverterParameter=3}"/>

                <RadioButton Content="提取偶数页（第 2、4、6... 页）"
                             IsChecked="{Binding SelectedSplitMode, Converter={StaticResource RadioButtonConverter}, ConverterParameter=4}"/>
            </StackPanel>
        </GroupBox>

        <!-- 输出设置 -->
        <GroupBox Grid.Row="3" Header="📂 输出设置" Style="{StaticResource GroupBoxStyle}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="输出目录" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource TextBoxStyle}" Width="350" IsReadOnly="True"/>
                    <Button Content="浏览" Command="{Binding SelectOutputPathCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="文件名" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding FileNameTemplate, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource TextBoxStyle}" Width="350"/>
                    <TextBlock Text="（{0} 代表页码）" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="🚀 开始拆分" Command="{Binding SplitCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Visibility="{Binding IsSplitting, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
            <Button Content="⏹ 取消" Command="{Binding CancelSplitCommand}"
                    Style="{StaticResource DangerButtonStyle}"
                    Visibility="{Binding IsSplitting, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>

        <!-- 进度条 -->
        <Grid Grid.Row="6" Margin="0,16,0,0" Visibility="{Binding IsSplitting, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ProgressBar Grid.Row="0" Value="{Binding ProgressValue}"/>
            <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>