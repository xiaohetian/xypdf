<UserControl x:Class="PdfToolbox.Views.DocumentToPdfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid x:Name="RootGrid"
          AllowDrop="True"
          DragEnter="RootGrid_DragEnter"
          DragOver="RootGrid_DragOver"
          DragLeave="RootGrid_DragLeave"
          Drop="RootGrid_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="文档转 PDF" Style="{StaticResource SectionTitleStyle}"/>

        <GroupBox Grid.Row="1" Header="文档类型" Style="{StaticResource GroupBoxStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="文档类型" Style="{StaticResource LabelStyle}"/>
                <ComboBox ItemsSource="{Binding DocumentTypes}"
                          SelectedItem="{Binding DocumentType}"
                          Style="{StaticResource ComboBoxStyle}" Width="100"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="输入文件" Style="{StaticResource GroupBoxStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="源文件" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource TextBoxStyle}" Width="400" IsReadOnly="True"/>
                <Button Content="浏览" Command="{Binding SelectInputFileCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="输出设置" Style="{StaticResource GroupBoxStyle}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="页面大小" Style="{StaticResource LabelStyle}"/>
                    <ComboBox ItemsSource="{Binding PageSizes}"
                              SelectedItem="{Binding PageSize}"
                              Style="{StaticResource ComboBoxStyle}" Width="100" Height="21"/>
                    <TextBlock Text="页边距" Style="{StaticResource LabelStyle}" Margin="24,0,0,0"/>
                    <TextBox Text="{Binding Margin, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource TextBoxStyle}" Width="80"/>
                    <TextBlock Text="点" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="12"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="输出路径" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource TextBoxStyle}" Width="350" IsReadOnly="True"/>
                    <Button Content="浏览" Command="{Binding SelectOutputPathCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="开始转换" Command="{Binding ConvertCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Visibility="{Binding IsConverting, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
            <Button Content="取消" Command="{Binding CancelConvertCommand}"
                    Style="{StaticResource DangerButtonStyle}"
                    Visibility="{Binding IsConverting, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>

        <Grid Grid.Row="6" Margin="0,16,0,0" Visibility="{Binding IsConverting, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ProgressBar Grid.Row="0" Value="{Binding ProgressValue}"/>
            <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </Grid>
    </Grid>
</UserControl>
