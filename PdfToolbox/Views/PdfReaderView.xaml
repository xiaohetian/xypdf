<UserControl x:Class="PdfToolbox.Views.PdfReaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:PdfToolbox.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <!-- 标签页样式（不带工具栏，工具栏在外部 Grid 中） -->
        <Style x:Key="ReaderTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0"
                                      Name="HeaderPanel"
                                      Panel.ZIndex="1"
                                      Margin="0,0,0,-1"
                                      IsItemsHost="True"/>
                            <ContentPresenter Grid.Row="1"
                                              x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"
                                              Margin="0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标签页头部样式 -->
        <Style x:Key="ReaderTabItemStyle" TargetType="TabItem">
            <Setter Property="Background" Value="#E8ECF0"/>
            <Setter Property="Foreground" Value="#5A6A7A"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6,6,0,0"
                                BorderThickness="1,1,1,0"
                                BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D8DCE0"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="White"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#D0D4D8"/>
                                <Setter Property="Foreground" Value="#2C3E50"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid"
          AllowDrop="True"
          DragEnter="RootGrid_DragEnter"
          DragOver="RootGrid_DragOver"
          DragLeave="RootGrid_DragLeave"
          Drop="RootGrid_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0: 顶部工具栏 -->
            <RowDefinition Height="*"/>     <!-- 1: 内容区域（TabControl + 空状态） -->
            <RowDefinition Height="Auto"/>  <!-- 2: 底部工具栏 -->
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="打开 PDF" Command="{Binding OpenPdfCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="↺" Command="{Binding RotateLeftCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" Margin="16,0,8,0"
                    ToolTip="逆时针旋转90°" Padding="14,8" FontSize="18"/>
            <Button Content="↻" Command="{Binding RotateRightCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    ToolTip="顺时针旋转90°" Padding="14,8" FontSize="18"/>
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="16,4" Width="1"/>
            <ComboBox ItemsSource="{Binding RecentFileItems}"
                      SelectedItem="{Binding SelectedRecentFile, Mode=TwoWay}"
                      Width="200"
                      IsEditable="False"
                      FontSize="12"
                      ToolTip="最近打开的文件">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding FilePath}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <!-- 标签页栏 -->
        <TabControl Grid.Row="1"
                    ItemsSource="{Binding Tabs}"
                    SelectedItem="{Binding SelectedTab}"
                    Style="{StaticResource ReaderTabControlStyle}"
                    ItemContainerStyle="{StaticResource ReaderTabItemStyle}"
                    Visibility="{Binding Tabs.Count, Converter={StaticResource CountToVisibilityConverter}}">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileName}" VerticalAlignment="Center"
                                   MaxWidth="150" TextTrimming="CharacterEllipsis"
                                   FontSize="13"/>
                        <Button Content="×"
                                Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                CommandParameter="{Binding}"
                                Width="20" Height="20"
                                Padding="0"
                                Margin="8,0,0,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                FontSize="14"
                                FontWeight="Bold"
                                ToolTip="关闭标签页">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Foreground" Value="#CC4444"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="#FF0000"/>
                                            <Setter Property="Background" Value="#FFE0E0"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <!-- 标签页内容区域 -->
                    <Grid Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 全部页面视图（垂直滚动） -->
                        <Border Background="White"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Effect="{StaticResource CardShadow}"
                                Visibility="{Binding DataContext.ShowAllPages, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          PanningMode="Both">
                                <ItemsControl ItemsSource="{Binding DataContext.AllPages, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="10">
                                                <TextBlock Text="{Binding PageNumber, StringFormat=第 {0} 页}" 
                                                           HorizontalAlignment="Center" 
                                                           Margin="0,0,0,8"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <Image Source="{Binding Image}"
                                                       Stretch="Uniform"
                                                       HorizontalAlignment="Center"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- 单页视图 -->
                        <Border Background="White"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Effect="{StaticResource CardShadow}"
                                Visibility="{Binding DataContext.ShowAllPages, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          PanningMode="Both">
                                <Image Source="{Binding DataContext.CurrentPageImage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       Stretch="None"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <!-- 无文档时的提示（与 TabControl 重叠在同一单元格） -->
        <Border Grid.Row="1" Background="White"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Effect="{StaticResource CardShadow}"
                Visibility="{Binding IsDocumentLoaded, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <TextBlock Text="请打开 PDF 文件开始阅读"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="16"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </Border>

        <!-- 底部工具栏 -->
        <Border Grid.Row="2" Background="White" Padding="16,12" CornerRadius="8" Effect="{StaticResource CardShadow}"
                Visibility="{Binding IsDocumentLoaded, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="首页" Command="{Binding FirstPageCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="上一页" Command="{Binding PreviousPageCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/>
                    <TextBlock VerticalAlignment="Center" Margin="8,0" FontSize="13">
                        <Run Text="{Binding CurrentPage, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text="/"/>
                        <Run Text="{Binding TotalPages, Mode=OneWay}"/>
                    </TextBlock>
                    <Button Content="下一页" Command="{Binding NextPageCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="6,0"/>
                    <Button Content="末页" Command="{Binding LastPageCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <!-- 视图切换按钮 -->
                    <Button Content="切换视图" Command="{Binding ToggleViewModeCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,12,0"
                            ToolTip="在单页模式和全部页面模式之间切换"/>
                    <!-- 缩放按钮 -->
                    <Button Content="缩小" Command="{Binding ZoomOutCommand}" 
                            Style="{StaticResource SecondaryButtonStyle}"  Margin="0,0,6,0"
                            Foreground="WhiteSmoke"/>
                    <TextBlock VerticalAlignment="Center" Margin="6,0" FontSize="13">
                        <Run Text="{Binding ZoomLevel, StringFormat={}{0:P0}, Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>
                    <Button Content="放大" Command="{Binding ZoomInCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"  Margin="6,0,0,0"
                            Foreground="WhiteSmoke"/>
                    <Button Content="适应宽度" Command="{Binding FitWidthCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="12,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
