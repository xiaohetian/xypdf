<UserControl x:Class="PdfToolbox.Views.PdfToImageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:PdfToolbox.ViewModels"
             xmlns:helpers="clr-namespace:PdfToolbox.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <helpers:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid x:Name="RootGrid"
          AllowDrop="True"
          DragEnter="RootGrid_DragEnter"
          DragOver="RootGrid_DragOver"
          DragLeave="RootGrid_DragLeave"
          Drop="RootGrid_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="添加 PDF" Command="{Binding AddPdfsCommand}"
                    Width="110" Height="32"
                    Background="DodgerBlue" Foreground="White" FontWeight="Bold"/>
            <Button Content="添加文件夹" Command="{Binding AddFolderCommand}"
                    Width="110" Height="32"
                    Background="Gray" Foreground="White" Margin="8,0,0,0"/>
            <Button Content="清空列表" Command="{Binding ClearAllCommand}"
                    Width="110" Height="32"
                    Background="Gray" Foreground="White" Margin="8,0,0,0"/>
        </StackPanel>

        <!-- 主要内容区域 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- PDF 文件列表 -->
            <Border Grid.Column="0" Background="White"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Effect="{StaticResource CardShadow}"
                    Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="PDF 文件列表"
                               FontSize="14" FontWeight="SemiBold"
                               Margin="12,12,12,8"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding PdfFiles}"
                             SelectedItem="{Binding SelectedFile}"
                             Margin="12,0,12,12"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding FileName}"
                                               VerticalAlignment="Center"
                                               Margin="8,4,8,4"/>

                                    <Button Grid.Column="1" Content="删除"
                                            Command="{Binding DataContext.RemovePdfCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,4,4,4"
                                            Padding="6,2"
                                            FontSize="11"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 转换设置 -->
            <Border Grid.Column="1" Background="White"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Effect="{StaticResource CardShadow}">
                <StackPanel Margin="16">

                    <!-- 输出文件夹 -->
                    <TextBlock Text="输出文件夹"
                               FontSize="13" FontWeight="SemiBold"
                               Margin="0,0,0,8"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Text="{Binding OutputFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="True"
                                 Background="#F8F9FA"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 BorderThickness="1"
                                 Padding="10,8"
                                 FontSize="12"/>

                        <Button Grid.Column="1" Content="浏览..."
                                Command="{Binding SelectOutputFolderCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,0,0,0"
                                Padding="10,8"
                                FontSize="12"/>
                    </Grid>

                    <!-- 图片格式 -->
                    <TextBlock Text="图片格式"
                               FontSize="13" FontWeight="SemiBold"
                               Margin="0,0,0,8"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <ComboBox ItemsSource="{Binding ImageFormats}"
                              SelectedItem="{Binding ImageFormat, Mode=TwoWay}"
                              Margin="0,0,0,16"
                              Padding="10,8"
                              FontSize="12"
                              BorderBrush="{DynamicResource BorderBrush}"
                              BorderThickness="1"/>

                    <!-- DPI 设置 -->
                    <TextBlock Text="图片质量 (DPI)"
                               FontSize="13" FontWeight="SemiBold"
                               Margin="0,0,0,8"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <ComboBox ItemsSource="{Binding DpiOptions}"
                              SelectedItem="{Binding Dpi, Mode=TwoWay}"
                              Margin="0,0,0,16"
                              Padding="10,8"
                              FontSize="12"
                              BorderBrush="{DynamicResource BorderBrush}"
                              BorderThickness="1"/>

                    <!-- 进度条 -->
                    <TextBlock Text="转换进度"
                               FontSize="13" FontWeight="SemiBold"
                               Margin="0,0,0,8"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <ProgressBar Value="{Binding ProgressValue}"
                                 Margin="0,0,0,4"/>

                    <TextBlock Text="{Binding ProgressValue, StringFormat={}{0}%}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <!-- 状态消息 -->
                    <TextBlock Text="{Binding StatusMessage}"
                               HorizontalAlignment="Left"
                               Margin="0,12,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               MaxHeight="40"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 底部工具栏 -->
        <Border Grid.Row="2" Background="White" Padding="16,12" CornerRadius="8" Effect="{StaticResource CardShadow}"
                Visibility="{Binding IsConverting, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="▶ 开始转换" Command="{Binding ConvertAsyncCommand}"
                            Width="130" Height="36" Margin="0,0,8,0"
                            Background="DodgerBlue" Foreground="White" FontWeight="Bold" FontSize="14"/>
                    <Button Content="✕ 取消" Command="{Binding CancelConvertCommand}"
                            Width="100" Height="36" Margin="8,0,0,0"
                            Background="Gray" Foreground="White" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 转换中遮罩 -->
        <Border Grid.Row="1" Grid.ColumnSpan="2"
                Background="#000000" Opacity="0.3"
                Visibility="{Binding IsConverting, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="转换中，请稍候..."
                       FontSize="16" Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>