<Window x:Class="LicenseTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LicenseTool"
        mc:Ignorable="d"
        Title="PDF Toolbox License Generator" Height="300" Width="500"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="PDF Toolbox License Generator" 
                   FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" Text="您的机器指纹码（请复制此码用于授权）：" 
                   FontSize="12" Margin="0,0,0,5"/>

        <TextBox x:Name="FingerprintTextBox" Grid.Row="2" 
                 IsReadOnly="True" 
                 Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                 FontFamily="Consolas" FontSize="14"
                 Padding="10"
                 TextWrapping="Wrap"
                 AcceptsReturn="False"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled"
                 MinHeight="60"/>

        <Button x:Name="SaveButton" Grid.Row="3" Content="保存许可证到 security.json"
                Click="SaveButton_Click"
                Height="35" FontSize="12"
                Margin="0,10,0,0"/>

        <TextBlock x:Name="StatusText" Grid.Row="4" 
                   FontSize="11" 
                   Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>